package com.streamix.scrapers.adult

import com.streamix.core.plugin.ContentCategory
import com.streamix.scrapers.*
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.jsoup.Jsoup

class PornhubScraper : BaseScraper {

    override val info = ScraperInfo(
        id = "pornhub",
        displayName = "PornHub",
        baseUrl = "https://www.pornhub.com",
        categories = listOf(ContentCategory.ADULT)
    )

    private val baseUrl get() = info.baseUrl

    override suspend fun getTrending(page: Int): List<ScrapeResult> = withContext(Dispatchers.IO) {
        val url = "$baseUrl/video?o=mv&page=$page" // most viewed
        val html = ScraperHttpClient.get(url, mapOf("Referer" to baseUrl)) ?: return@withContext emptyList()
        parseVideoList(html)
    }

    override suspend fun search(query: String, page: Int): List<ScrapeResult> = withContext(Dispatchers.IO) {
        val encoded = java.net.URLEncoder.encode(query, "UTF-8")
        val url = "$baseUrl/video/search?search=$encoded&page=$page"
        val html = ScraperHttpClient.get(url, mapOf("Referer" to baseUrl)) ?: return@withContext emptyList()
        parseVideoList(html)
    }

    private fun parseVideoList(html: String): List<ScrapeResult> {
        return try {
            val doc = Jsoup.parse(html)
            val results = mutableListOf<ScrapeResult>()

            // PornHub video block selectors
            doc.select("li.videoblock, li.pcVideoListItem, .wrap").forEach { el ->
                val titleEl = el.select("span.title a, .title a").firstOrNull() ?: return@forEach
                val title = titleEl.text().trim()
                val href = titleEl.attr("href")
                if (title.isEmpty() || href.isEmpty()) return@forEach

                val link = if (href.startsWith("http")) href else "$baseUrl$href"
                val img = el.select("img").firstOrNull()
                val thumb = img?.attr("data-src")?.ifEmpty { img.attr("src") } ?: img?.attr("src") ?: ""
                val duration = el.select(".duration, var.duration").text()

                results.add(ScrapeResult(
                    id = link,
                    title = title,
                    posterUrl = thumb.takeIf { it.startsWith("http") },
                    pageUrl = link,
                    duration = duration,
                    sourceId = info.id
                ))
            }
            results.distinctBy { it.pageUrl }.take(30)
        } catch (e: Exception) { emptyList() }
    }

    override suspend fun getStreamLinks(pageUrl: String): List<StreamResult> = withContext(Dispatchers.IO) {
        val html = ScraperHttpClient.get(pageUrl, mapOf("Referer" to baseUrl))
            ?: return@withContext emptyList()

        val results = mutableListOf<StreamResult>()

        // Try HLS master playlist
        val hlsRegex = Regex(""""hls_url":\s*"(https?://[^"]+\.m3u8[^"]*)"""")
        hlsRegex.find(html)?.groupValues?.get(1)?.let { url ->
            results.add(StreamResult(url = url.replace("\\/", "/"), quality = "Auto", format = "hls"))
        }

        // Try quality-specific mp4 links
        val qualityRegex = Regex(""""videoUrl([0-9]+p)":\s*"(https?://[^"]+)"""")
        qualityRegex.findAll(html).forEach { m ->
            val quality = m.groupValues[1]
            val url = m.groupValues[2].replace("\\/", "/")
            results.add(StreamResult(url = url, quality = quality, format = "mp4"))
        }

        // Fallback: look for any .m3u8 URL in the page
        if (results.isEmpty()) {
            val m3u8Regex = Regex("""(https?://[^\s"']+\.m3u8[^\s"']*)""")
            m3u8Regex.find(html)?.groupValues?.get(1)?.let { url ->
                results.add(StreamResult(url = url, quality = "Auto", format = "hls"))
            }
        }

        results
    }
}
